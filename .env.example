# =============================================================================
# AI Avatar Companion — Environment Configuration
# =============================================================================
# Copy this file to `.env.local` and fill in your real keys.
# Never commit `.env.local` to git.
# =============================================================================

# ---- AI Provider (choose ONE) ----

# Option A: Anthropic Claude (default, recommended)
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Option B: OpenAI (uncomment and use these instead)
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# Option C: Google AI Studio / Gemini (uncomment and use these instead)
# Get a key at https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=your-google-ai-studio-key-here
# GOOGLE_MODEL=gemini-2.0-flash

# Which provider to use: "anthropic", "openai", or "google"
AI_PROVIDER=anthropic

# ---- Assistant identity (safe to change) ----
ASSISTANT_NAME=Mira
ASSISTANT_PERSONA="warm, intelligent, professional, gently playful"

# ---- Optional: external TTS provider (e.g. ElevenLabs) ----
# Leave blank to use the browser's built-in SpeechSynthesis (default for MVP).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ---- Live video avatar (Simli) ----
# When both are set, the avatar becomes a real-time lip-synced video.
# If unset, the app falls back to the static image + browser voice.
# Get a key + face id at https://app.simli.com/
# SIMLI_API_KEY=your-simli-api-key
# SIMLI_FACE_ID=your-simli-face-id

# Voice that drives the avatar's lips (used only when Simli is enabled).
# Reuses your Google AI Studio key. Pick any voice: Kore, Aoede, Puck,
# Charon, Leda, Zephyr, etc. (see Gemini speech-generation docs).
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# TTS is resilient: if a model fails or doesn't respond, the server
# automatically falls back to the next one. The chain is GEMINI_LIVE_MODELS
# first, then GEMINI_TTS_MODEL, then GEMINI_TTS_MODELS (comma-separated), then
# built-in defaults (gemini-2.5-flash-preview-tts, gemini-3.1-flash-tts-preview,
# gemini-2.5-pro-preview-tts). Override the fallback order here if you like:
# GEMINI_TTS_MODELS=gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts

# Optional: realtime Gemini Live API models (native-audio dialog / live) for the
# avatar voice. These use the bidirectional Live API (WebSocket) instead of the
# one-shot TTS endpoint and are tried first when set. They degrade gracefully
# to the TTS models above if unavailable on your key. Comma-separated, e.g.:
# GEMINI_LIVE_MODELS=gemini-2.5-flash-preview-native-audio-dialog
# (add the Gemini 3 Flash Live model id here too once you have access)

# ---- Gemini Live (primary voice mode) — optional, reuses GOOGLE_API_KEY ----
# When enabled (and GOOGLE_API_KEY is set), voice calls open a realtime
# Gemini Live session first: one low-latency WebSocket replaces the whole
# STT -> chat -> TTS round trip, with native barge-in. The browser connects
# directly to Google using a short-lived ephemeral token minted by
# /api/live-token — the real key never reaches the client. If Live is off,
# misconfigured, or drops mid-call, the app falls back to the classic
# pipeline below automatically (conversation context preserved).
# ENABLE_GEMINI_LIVE=true
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Voice for Live replies (falls back to GEMINI_TTS_VOICE, then Aoede — female).
# Without an explicit voice Google uses its default MALE voice. Female options:
# Aoede (warm), Kore (firm), Leda (youthful), Zephyr (bright).
# GEMINI_LIVE_VOICE=Aoede

# ---- Deepgram TTS (classic pipeline primary voice) ----
# The classic voice chain is: Deepgram -> Gemini TTS -> browser. Deepgram is
# tried first when this key is set. Get a key at https://console.deepgram.com/
# DEEPGRAM_API_KEY=your-deepgram-key
# DEEPGRAM_TTS_MODEL=aura-2-luna-en

# ---- Mira Vision (camera) ----
# Vision uses your existing GOOGLE_API_KEY (Gemini vision) or OPENAI_API_KEY
# (OpenAI vision), chosen like AI_PROVIDER. No extra key needed. Optionally
# override the vision model:
# GEMINI_VISION_MODEL=gemini-2.0-flash
# OPENAI_VISION_MODEL=gpt-4o-mini

# ---- Abuse & cost protection (API rate limiting) ----
# Distributed, serverless-friendly rate limiting via Upstash Redis. When BOTH
# vars are set, all API routes share a per-IP sliding-window limit that works
# across stateless serverless instances. If left UNSET, the app falls back to a
# simple in-memory limiter automatically — fine for local dev, no setup needed.
# Create a free Redis database at https://console.upstash.com/ and copy its
# REST URL + token here.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional: allow a trusted programmatic caller past the same-origin check by
# sending this value as an `x-api-secret` request header.
# API_SHARED_SECRET=your-long-random-secret
